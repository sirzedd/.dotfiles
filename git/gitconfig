# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
name = Joshua Hendricks
email = 
[alias]
# Git Town
#	Using git tool called git-branchless
#
# Smart pull stash, pull, then stash pop
  smart-pull = "!f() { git stash push -m 'auto-stash'; git pull; git stash pop; }; f"
# Quick pull of current
  push-current = push origin HEAD
# Sync with main
  sync-main = "!f() { git fetch origin main:main && git merge main; }; f"


# STASHING 
  save = stash push -m # git save "feature"
  stashes = stash list #     git stashes shows list
  pop-save = !git stash apply stash^{/} #git pop-save feature

  stash-select = !sh -c 'git stash list | fzf --height 40% --reverse --ansi \
      --preview \"echo {} | cut -d: -f1 | xargs git stash show -p --color=always\" \
      --preview-window=right:65% \
      --bind \"enter:execute(echo {} | cut -d: -f1 | xargs git stash apply)+abort\" \
      --bind \"ctrl-d:execute(echo {} | cut -d: -f1 | xargs git stash drop)+abort\" \
      --bind \"ctrl-p:execute(echo {} | cut -d: -f1 | xargs git stash pop)+abort\" \
      --header \"Enter: apply, C-d: drop, C-p: pop\"' -

  stash-browse = !sh -c 'git stash list | fzf --height 40% --reverse --ansi \
      --preview \"echo {} | cut -d: -f1 | xargs git stash show -p --color=always\" \
      --preview-window=right:65%' -

  # Pulling
  pulldevelop = "!git checkout develop && git pull --set-upstream origin develop && git checkout -"

  ## Checkout files
  #Use ctrl-tab to select multiple
  checkoutfiles = "!f() { git checkout $(git status -s | fzf | awk '{print $2}'); }; f"

  ##Restore files that are staged
  restorefiles = "!git diff --name-only --cached | fzf --print0 -m | xargs -0 -t -o git restore --staged"

  ##Deleting
  deleteremotebranches = "!f() { git branch --merged | egrep -v '(^\\*|develop|main)' | fzf -m | xargs -r git branch -d; }; f"
  deletebranches = "!f() { git branch --format='%(refname:short)' | fzf -m | xargs git branch -D; }; f"
  prune-branches = '!git remote prune origin && git branch -vv | grep ": gone]" | awk "{print $1}" | xargs git branch -D'

  ## Stash
  stash-apply = "!git stash list | fzf --reverse --height=50% | cut -d: -f1 | xargs -r git stash apply"
  # git sp -u to include untracked files or -a to include ignored files
  # git sp "Stash"
  sp = '!f() { git stash push -m "$1" "$@"; }; f'
  #  quick stash 
  st = !git stash push -m

# commit with template
  cm = !bash -c git-commit-template

  ls = log --oneline

  cod = checkout  develop
  fb = !zsh -c fbr
  fadd = "!git ls-files -m -o --exclude-standard | fzf --print0 -m | xargs -0 -t -o git add"
  fco = "!git ls-files -m -o --exclude-standard | fzf --print0 -m | xargs -0 -t -o git checkout"
  frestore = "!git diff --name-only --cached | fzf --print0 -m | xargs -0 -t -o git restore --staged"
  fmerge = "!fmerge"
  fdiff = "!fdiff"
  fstash = "!fstash"  
  echo = !echo $PATH
## Commit with same message as last
	redo = commit --reuse-message=HEAD
## quikc push 
	p = push origin HEAD
# interactive add
	patch = add -p
# interactive remove
	unpatch = reset -p
  
[core]
	editor = /opt/homebrew/bin/nvim
  pager = delta
[branch]
#	autoSetupMerge = off
[commit]
	template = /Users/joshua.hendricks/.dotfiles/git/git-commit-message.txt
[interactive]
    diffFilter = delta --color-only
[delta]
    side-by-side = true
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
[merge]
  conflictstyle = zdiff3
	log = false

