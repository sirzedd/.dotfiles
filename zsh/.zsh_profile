# Functions
function ap() {
  if [[ $@ == *"-p"* ]]; then
    MY_INPUT=$(</dev/stdin)
    echo $MY_INPUT > /tmp/atom-project-tmp.diff
    groovy ~/bin/atom-project.groovy -f /tmp/atom-project-tmp.diff
  else
    groovy ~/bin/atom-project.groovy $@
  fi
}

function compare_dirs() {
 # List of file patterns to ignore
  IGNORE_PATTERNS=(".DS_Store" "Thumbs.db" "*.log")

  if [ $# -ne 2 ]; then
    echo "Usage: $0 <directory1> <directory2>"
    exit 1
  fi

  dir1=$1
  dir2=$2

  # Escape special characters in the patterns
  escaped_patterns=()
  for pattern in "${IGNORE_PATTERNS[@]}"; do
    escaped_patterns+=("$(printf '%s' "$pattern" | sed 's/[]\[^$.*/+?(){}|]/\\&/g')")
  done

  # Join the patterns with '|'
  IGNORE_REGEX=$(IFS='|'; echo "${escaped_patterns[*]}")

  echo "Comparing $dir1 with $dir2 for presence/absence of files and directories (ignoring: ${IGNORE_PATTERNS[*]}):"

  # Perform comparison and filter out ignored patterns
  diff -qr "$dir1" "$dir2" | grep -E "(Only in)" | grep -Ev "$IGNORE_REGEX"
}


notify_me() {
  local description="$1"
  shift
  "$@" && osascript -e "display notification \"$description\" with title \"Terminal Command Completed\"" || osascript -e "display notification \"$description\" with title \"Terminal Command Failed\""
}

function pb_jq() {
  pbpaste | jq | pbcopy
}

function tmux-resurrect-reset-last() {
    cd ~/.tmux/resurrect && \
        ln -f -s $(/bin/ls -t tmux_resurrect_*.txt | head -n 1) last && \
        /bin/ls -l last
}

function zcf() {
    vim ~/.dotfiles/zsh/.zsh_profile
}

function tcf() {
    vim ~/.dotfiles/tmux/.tmux.conf
}

function vcf() {
    vim ~/.dotfiles/vim/init.vim
}


function gitdiff() {
  preview="git diff $@ --color=always -- {-1}"
  git diff $@ --name-only | fzf -m --ansi --preview $preview
}

# Function for testing shell load time
timezsh() {
  shell=${1-$SHELL}
  for i in $(seq 1 10); do /usr/bin/time $shell -i -c exit; done
}

